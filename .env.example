# ===========================================
# Microservice Template - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# See contracts/env-variables.md for full documentation.

# --- Profile Selection ---
# Comma-separated list of Spring profiles to activate.
# Options: local, dev, test, prod
SPRING_PROFILES_ACTIVE=local

# --- Server ---
# HTTP port. Each microservice should use a unique port (8081-8087).
SERVER_PORT=8080

# --- Database (required for dev/prod) ---
# JDBC URL for PostgreSQL.
# dev default: jdbc:postgresql://localhost:5432/dev_db
DB_URL=jdbc:postgresql://localhost:5432/dev_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Logging ---
# Root logging level. Options: ERROR, WARN, INFO, DEBUG, TRACE
# dev default: INFO, prod default: WARN
LOG_LEVEL=INFO
