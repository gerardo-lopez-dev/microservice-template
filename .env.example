# ===========================================
# Microservice Template - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Used by both the Spring Boot application and docker-compose.yml.

# --- Profile Selection ---
# Active Spring profile(s). Options: local, dev, test, prod
# Default: local
SPRING_PROFILES_ACTIVE=local

# --- Server ---
# HTTP port for the embedded server.
# Default: 8080
SERVER_PORT=8080

# --- Docker Compose ports ---
# Host ports exposed by infrastructure services.
# Change these if the defaults conflict with other local services.
APP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092

# --- Database (required for dev/prod) ---
# JDBC URL for PostgreSQL. Used by dev and prod profiles.
# dev default: jdbc:postgresql://localhost:5432/dev_db
# prod: no default — must be set explicitly
DB_URL=jdbc:postgresql://localhost:5432/dev_db

# PostgreSQL credentials. Also used by docker-compose.yml for the postgres service.
# Required in prod (no default in application-prod.yaml).
# Default (dev): postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Logging ---
# Root logging level. Options: ERROR, WARN, INFO, DEBUG, TRACE
# local default: DEBUG | dev default: INFO | prod default: WARN | test: WARN
LOG_LEVEL=INFO
